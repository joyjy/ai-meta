#!/usr/bin/env python3
"""Validate a skill with upstream checks plus ai-meta integration gates."""

from __future__ import annotations

import argparse
import re
import subprocess
import sys
import tempfile
from pathlib import Path

import yaml


REPO_ROOT = Path(__file__).resolve().parent.parent
UPSTREAM_VALIDATOR = (
    Path.home() / ".codex" / "skills" / ".system" / "skill-creator" /
    "scripts" / "quick_validate.py"
)
AI_META_FRONTMATTER_EXTENSIONS = {"disable-model-invocation"}
FRONTMATTER_RE = re.compile(r"^---\n(.*?)\n---", re.DOTALL)


def is_ai_meta_skill(path: Path) -> bool:
    try:
        path.resolve().relative_to((REPO_ROOT / "skills").resolve())
    except ValueError:
        return False
    return True


def sanitize_skill_copy(source: Path, destination: Path) -> None:
    destination.mkdir(parents=True)
    skill_md = destination / "SKILL.md"
    content = (source / "SKILL.md").read_text(encoding="utf-8")
    match = FRONTMATTER_RE.match(content)
    if not match:
        return
    frontmatter = yaml.safe_load(match.group(1))
    if not isinstance(frontmatter, dict):
        return
    for key in AI_META_FRONTMATTER_EXTENSIONS:
        frontmatter.pop(key, None)
    rendered = yaml.safe_dump(
        frontmatter, allow_unicode=True, sort_keys=False).rstrip()
    skill_md.write_text(
        f"---\n{rendered}\n---{content[match.end():]}", encoding="utf-8")


def run_checked(label: str, command: list[str]) -> bool:
    print(f"[{label}] {' '.join(command)}", flush=True)
    result = subprocess.run(command, check=False)
    return result.returncode == 0


def validate(path: Path, upstream_validator: Path) -> int:
    if not path.is_dir():
        print(f"validate-skill: skill directory not found: {path}", file=sys.stderr)
        return 1
    if not upstream_validator.is_file():
        print(
            f"validate-skill: upstream validator not found: {upstream_validator}",
            file=sys.stderr,
        )
        return 1

    ai_meta = is_ai_meta_skill(path)
    with tempfile.TemporaryDirectory(prefix="validate-skill-") as tmp:
        target = path
        if ai_meta:
            target = Path(tmp) / path.name
            sanitize_skill_copy(path, target)
        if not run_checked(
                "upstream",
                [sys.executable, str(upstream_validator), str(target)]):
            return 1

    if not ai_meta:
        return 0

    gates = [
        REPO_ROOT / "scripts" / "check-skill-invocation-policies",
        REPO_ROOT / "scripts" / "check-codex-command-entries",
    ]
    for gate in gates:
        if not run_checked("ai-meta", [str(gate)]):
            return 1
    print(f"validate-skill: passed {path}")
    return 0


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Run upstream skill validation and ai-meta integration gates.")
    parser.add_argument("skill_dir", type=Path)
    parser.add_argument(
        "--upstream-validator",
        type=Path,
        default=UPSTREAM_VALIDATOR,
        help="Override the system quick_validate.py path.",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    return validate(args.skill_dir.resolve(), args.upstream_validator.resolve())


if __name__ == "__main__":
    raise SystemExit(main())
