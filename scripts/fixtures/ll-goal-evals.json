      "constraints": ["只读诊断"]
    },
    "expected_binding": {
      "allowed_side_effects": ["read"],
      "ask_before": ["scope_change", "remote_write", "destructive_action", "high_cost_unstable_validation", "low_confidence_execution"],
      "call_user_when": ["scope_change", "remote_write", "destructive_action", "acceptance_gap", "business_judgment"]
    }
  },
