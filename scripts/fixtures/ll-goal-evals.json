[
  {
    "name": "local_bug_fix",
    "ff": {
      "goal": "修复 ll-ledger 追加事件后未正确派生 checkpoint 状态的问题。",
      "scope": {
        "include": [
          "scripts/ll-ledger",
          "scripts/ll_contract_file.py"
        ],
        "exclude": [
          "commit",
          "push",
          "MR"
        ]
      },
      "acceptance": [
        "checkpoint 事件按追加顺序更新有效状态",
        "无效 checkpoint id 被拒绝且原文件不变",
        "相关回归测试通过"
      ],
      "constraints": [
        "只允许本地编辑和轻量测试"
      ]
    },
    "expected_binding": {
      "allowed_side_effects": [
        "read",
        "local_edit",
        "light_test"
      ],
      "ask_before": [
        "scope_change",
        "remote_write",
        "destructive_action",
        "high_cost_unstable_validation",
        "low_confidence_execution"
      ],
      "call_user_when": [
        "scope_change",
        "remote_write",
        "destructive_action",
        "acceptance_gap"
      ]
    }
  }
