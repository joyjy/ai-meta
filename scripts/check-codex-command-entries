#!/usr/bin/env bash
set -euo pipefail

repo="$(cd "$(dirname "$0")/.." && pwd)"

codex_skill_for_command() {
  case "$1" in
    cc) printf '%s\n' "coding-conventions" ;;
    ee) printf '%s\n' "engineering-exit" ;;
    ff) printf '%s\n' "final-form" ;;
    ll) printf '%s\n' "loop-ledger" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

is_published_command() {
  case "$1" in
    *.md) return 0 ;;
    *) return 1 ;;
  esac
}

is_declared_non_codex() {
  grep -qiE 'non-?Codex|非 Codex|非Codex|Codex.*不支持|不支持.*Codex' "$1"
}

status=0
for command_file in "$repo"/commands/*.md; do
  command_name="$(basename "$command_file" .md)"
  if ! is_published_command "$(basename "$command_file")"; then
    continue
  fi

  skill_name="$(codex_skill_for_command "$command_name")"
  skill_file="$repo/skills/$skill_name/SKILL.md"
  if [ -f "$skill_file" ]; then
    echo "ok: /$command_name -> skills/$skill_name/SKILL.md"
    continue
  fi

  if is_declared_non_codex "$command_file"; then
    echo "ok: /$command_name declared non-Codex"
    continue
  fi

  status=1
  echo "missing Codex entry: commands/$command_name.md" >&2
  echo "  add skills/$command_name/SKILL.md, add an alias in scripts/check-codex-command-entries, or mark the command non-Codex." >&2
done

exit "$status"
