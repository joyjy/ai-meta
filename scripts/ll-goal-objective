#!/usr/bin/env python3
"""Render a host goal start from a verified legacy or segmented LL file."""

from __future__ import annotations

import argparse
import json
import shlex
import subprocess
import sys
import time
from pathlib import Path
from typing import Any

import cli_usage
from ll_contract_file import load_path

CLI = "ll-goal-objective"
HOSTS = ["codex", "claude"]
# Claude Code truncates a /goal condition past this length when it repeats it.
CLAUDE_CONDITION_LIMIT = 500
TRIVIAL_CONFIRMATIONS = {
    "ok",
    "okay",
    "continue",
    "yes",
    "好",
    "好的",
    "继续",
    "可以",
}


def get(data: dict[str, Any], path: str) -> Any:
    current: Any = data
    for part in path.split("."):
        if not isinstance(current, dict) or part not in current:
            return None
        current = current[part]
    return current


def fail(message: str) -> int:
    print(f"ERROR {message}", file=sys.stderr)
    return 1


def normalized_text(value: Any) -> str:
    if not isinstance(value, str):
        return ""
    return " ".join(value.split())


def claude_goal_line(contract_path: Path) -> str:
    """The model cannot clear a goal, so every non-active status must satisfy it."""
    ledger = shlex.quote(str(contract_path))
    hot = shlex.quote(str(Path(__file__).with_name("ll-hot-block").resolve()))
    turn = shlex.quote(str(Path(__file__).with_name("ll-turn").resolve()))
    condition = (
        f"账本 {ledger}，按 loop-ledger skill 执行。每轮先运行 {hot} <账本> 并按输出执行，"
        f"结果用 {turn} compile-reply <账本> --input <json> 提交。"
        "完成条件：回复中原样写出最近一次 ll-hot-block 输出的首行，"
        "且其 status 值为 completed、needs_human、blocked 或 hot_rejected。"
    )
    if len(condition) > CLAUDE_CONDITION_LIMIT:
        raise ValueError(
            f"Claude goal condition has {len(condition)} characters; the limit "
            f"is {CLAUDE_CONDITION_LIMIT}; use a shorter ledger path")
    return f"/goal {condition}"


def render(contract_arg: str, host: str) -> int:
    contract_path = Path(contract_arg).expanduser().resolve()
    if not contract_path.is_file():
        return fail(f"contract does not exist: {contract_path}")

    verifier = Path(__file__).with_name("verify-ll-contract")
    verification = subprocess.run(
        [str(verifier), str(contract_path)],
        check=False,
        capture_output=True,
        text=True,
    )
    if verification.returncode != 0:
        detail = verification.stdout.strip() or verification.stderr.strip()
        return fail(f"contract verification failed: {detail}")

    try:
        document = load_path(contract_path)
        data = document.contract
    except (OSError, ValueError) as exc:
        return fail(f"cannot read contract: {exc}")

    if get(data, "runtime_binding.adapter") != "codex_goal":
        return fail("runtime_binding.adapter must be codex_goal")
    if get(data, "ll_contract.exit.state") != "active":
        return fail("Codex goal dispatch requires exit.state=active")
    if get(data, "ll_contract.exit.next_action") != "continue":
        return fail("Codex goal dispatch requires exit.next_action=continue")

    objective = normalized_text(get(data, "runtime_binding.objective"))
    if not objective:
        return fail("runtime_binding.objective is required")
    if objective.casefold() in TRIVIAL_CONFIRMATIONS:
        return fail("runtime_binding.objective cannot be a confirmation reply")

    if host == "claude":
        try:
            print(claude_goal_line(contract_path))
        except ValueError as exc:
            return fail(str(exc))
        return 0

    if document.segmented:
        brief_renderer = Path(__file__).with_name("ll-hot-block").resolve()
        brief_command = (
            f"{shlex.quote(str(brief_renderer))} "
            f"{shlex.quote(str(contract_path))}"
        )
    else:
        brief_renderer = Path(__file__).with_name("ll-brief").resolve()
        brief_command = (
            f"{shlex.quote(str(brief_renderer))} "
            f"{shlex.quote(str(contract_path))}"
        )
    print(f"执行并完成：{objective}")
    print()
    print("普通轮次只读取 LL 动态 hot block：")
    print(brief_command)
    print()
    if document.segmented:
        turn_compiler = Path(__file__).with_name("ll-turn").resolve()
        print(
            "每个 Focus 边界把结构化结果写入短 JSON，并编译下一轮状态："
        )
        print(
            f"{shlex.quote(str(turn_compiler))} compile-reply "
            f"{shlex.quote(str(contract_path))} --input <result.json>"
        )
        print("子 Focus 完成后仍须回到 Root 对照验收；不要用聊天 prose 代替状态事件。")
        print()
    print(
        f"同一文件后部是 append-only ledger：{contract_path}。仅在恢复、人工 gate、"
        "状态迁移或最终审计时读取尾部；更新通过 ll-ledger append 追加。遇到 "
        "needs_human 条件时停止等待用户；只有全部 done_when 有外部证据时才能完成 goal。")
    return 0


def main(argv: list[str] | None = None) -> int:
    started = time.monotonic()
    args = list(sys.argv[1:] if argv is None else argv)
    if args == ["usage"]:
        summary = cli_usage.summarize(CLI, [*HOSTS, "usage"])
        print(json.dumps(summary, ensure_ascii=False, indent=2))
        cli_usage.record(CLI, "usage", started, 0)
        return 0
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("ll_file", help="exact legacy JSON or segmented .ll path")
    parser.add_argument(
        "--host", choices=HOSTS, default="codex",
        help="codex prints the goal objective; claude prints a /goal line")
    parsed = parser.parse_args(args)
    code = render(parsed.ll_file, parsed.host)
    cli_usage.record(CLI, parsed.host, started, code)
    return code


if __name__ == "__main__":
    raise SystemExit(main())
