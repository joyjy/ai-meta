#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: project-line-counts <scan-root> [--markdown] [--limit N]

Print the largest text files under <scan-root> by line count, pruning common
generated/vendor/cache directories and skipping binary files. Pass the resolved
source or project root, not a parent workspace directory.
EOF
}

root=""
markdown=false
limit=10

while [ "$#" -gt 0 ]; do
  case "$1" in
    --markdown)
      markdown=true
      shift
      ;;
    --limit)
      if [ "$#" -lt 2 ]; then
        echo "project-line-counts: --limit requires a value" >&2
        exit 2
      fi
      limit="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      echo "project-line-counts: unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      if [ -n "$root" ]; then
        echo "project-line-counts: only one scan root is supported" >&2
        usage >&2
        exit 2
      fi
      root="$1"
      shift
      ;;
  esac
done

if [ -z "$root" ]; then
  echo "project-line-counts: missing scan root" >&2
  usage >&2
  exit 2
fi

case "$limit" in
  ''|*[!0-9]*)
    echo "project-line-counts: --limit must be a positive integer" >&2
    exit 2
    ;;
esac

if [ "$limit" -eq 0 ]; then
  exit 0
fi

if [ ! -d "$root" ]; then
  echo "project-line-counts: not a directory: $root" >&2
  exit 1
fi

find_args=(
  "$root"
  "("
  -name .git -o
  -name node_modules -o
  -name vendor -o
  -name tmp -o
  -name dist -o
  -name build -o
  -name .venv -o
  -name __pycache__ -o
  -name .next -o
  -name coverage -o
  -name .cache
  ")"
  -prune -o
  -type f
)

{
  if git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git -C "$root" ls-files -z --cached --others --exclude-standard -- . |
      while IFS= read -r -d '' path; do
        printf '%s\0' "$root/$path"
      done
  else
    find "${find_args[@]}" -print0
  fi
} |
  while IFS= read -r -d '' path; do
    if [ ! -f "$path" ]; then
      continue
    fi
    case "$path" in
      *.patch|*.diff|*.lock|*.snap)
        continue
        ;;
    esac
    if [ "$markdown" = true ] && [[ "$path" != *.md ]]; then
      continue
    fi
    if [ ! -s "$path" ] || LC_ALL=C grep -Iq '' "$path"; then
      lines="$(wc -l < "$path")"
      printf '%s %s\n' "$lines" "$path"
    fi
  done |
  sort -nr |
  head -"$limit"
