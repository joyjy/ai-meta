#!/usr/bin/env bash
# claude-statusline — Claude Code status line: dir, git, model, effort, context, rate limits, cost.
# Reads the status line JSON from stdin; a segment is hidden when its field is missing.

input=$(cat)

field() { jq -r "$1 // empty" <<<"$input"; }

# Percentage colored green < 50, yellow 50-80, red > 80.
pct() {
  local p color
  p=$(printf '%.0f' "$1")
  if [ "$p" -gt 80 ]; then color=31
  elif [ "$p" -ge 50 ]; then color=33
  else color=32
  fi
  printf '\033[%sm%s%%\033[0m' "$color" "$p"
}

limit() {
  local window="$1" label="$2" fmt="$3" used reset
  used=$(field ".rate_limits.$window.used_percentage")
  [ -n "$used" ] || return 0
  printf ' %s:' "$label"
  pct "$used"
  reset=$(field ".rate_limits.$window.resets_at")
  if [ -n "$reset" ]; then
    printf ' \033[2m(resets %s)\033[0m' "$(date -r "${reset%.*}" "+$fmt")"
  fi
}

dir=$(field .workspace.current_dir)
[ -n "$dir" ] || dir=$(field .cwd)
printf '\033[32m➜\033[0m \033[36m%s\033[0m' "$(basename "$dir")"

branch=$(git -C "$dir" --no-optional-locks symbolic-ref --short HEAD 2>/dev/null ||
  git -C "$dir" --no-optional-locks rev-parse --short HEAD 2>/dev/null)
if [ -n "$branch" ]; then
  printf ' \033[34mgit:(\033[31m%s\033[34m)\033[0m' "$branch"
  git -C "$dir" --no-optional-locks diff-index --quiet HEAD -- 2>/dev/null || printf ' \033[33m✗\033[0m'
fi

printf ' \033[2m%s\033[0m' "$(field .model.display_name)"

effort=$(field .effort.level)
[ -z "$effort" ] || printf ' \033[35m%s\033[0m' "$effort"

ctx=$(field .context_window.used_percentage)
if [ -n "$ctx" ]; then
  printf ' ctx:'
  pct "$ctx"
  used=$(field .context_window.total_input_tokens)
  size=$(field .context_window.context_window_size)
  if [ -n "$used" ] && [ -n "$size" ]; then
    printf ' \033[2m(%sk/%sk)\033[0m' "$((used / 1000))" "$((size / 1000))"
  fi
fi

limit five_hour 5h '%H:%M'
limit seven_day 7d '%m/%d %H:%M'

cost=$(field .cost.total_cost_usd)
[ -z "$cost" ] || printf ' \033[2m$%.2f\033[0m' "$cost"
