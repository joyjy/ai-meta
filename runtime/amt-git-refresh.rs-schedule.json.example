{
  "schemaVersion": "OwnerExternalWorkflowRegistry@1",
  "workflows": [
    {
      "schemaVersion": "OwnerExternalWorkflowRegistration@1",
      "ref": "workflow:amt/git-refresh@1",
      "inputSchema": "AmtGitRefreshInput@1",
      "fixedInput": {
        "mode": "branch-cleanup-dry-run"
      },
      "command": {
        "executable": "file:///Users/you/Documents/me/<maintenance-checkout>/scripts/amt-git-refresh",
        "arguments": [
          "--root",
          "/Users/you/Documents/projects",
          "--root",
          "/Users/you/Documents/reference",
          "--exclude",
          "/Users/you/Documents/projects/example-device-api",
          "--exclude",
          "/Users/you/Documents/projects/example-workflow-service",
          "--output",
          "/Users/you/.ai/amt/runtime/git-refresh.json",
          "--cleanup-merged-branches",
          "--branch-cleanup-dry-run",
          "--branch-cleanup-exclude-project-prefix",
          "example-org/3rd/",
          "--once-per-day"
        ],
        "cwd": "file:///Users/you/Documents/me/<maintenance-checkout>",
        "environment": {
          "HOME": "/Users/you",
          "PATH": "/Users/you/.asdf/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
          "AMT_GTD_COMMAND": "/Users/you/.ai/scripts/gtd",
          "AMT_GTD_NODE": "/Users/you/.asdf/shims/node",
          "GIT_TERMINAL_PROMPT": "0"
        },
        "timeoutMilliseconds": 1800000,
        "maxOutputBytes": 131072
      },
      "authority": {
        "filesystemRoots": [
          "file:///Users/you/Documents/me/<maintenance-checkout>",
          "file:///Users/you/Documents/projects",
          "file:///Users/you/Documents/reference",
          "file:///Users/you/.ai"
        ],
        "networkAccess": true
      },
      "retry": {
        "maxAttempts": 2,
        "backoffMilliseconds": 30000
      }
    }
  ]
}
