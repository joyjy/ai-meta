{
  "name": "@example-user/node-test-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Coding-conventions owned Node test runner, fixtures, V8 coverage, and entrypoint diagnostics.",
  "type": "module",
  "bin": {
    "node-test-kit": "bin/node-test-kit.mjs"
  },
