#!/usr/bin/env python3
"""Evaluate a native TypeSafe Jev request from a file or stdin."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

from jev_client import JevError, api_key_from_environment, evaluate


def main() -> int:
    parser = argparse.ArgumentParser(description="Evaluate a TypeSafe Jev JSON request")
    parser.add_argument("input", nargs="?", default="-", help="request JSON path, or - for stdin")
    parser.add_argument("--env-file", help="private env file; overrides TYPESAFE_API_KEY and ~/.ai/jev.env")
    parser.add_argument("--timeout", type=float, default=20.0, help="seconds per attempt, 0 < value <= 120")
    parser.add_argument("--retries", type=int, default=2, help="transient retries, 0..3")
    args = parser.parse_args()
    try:
        source = sys.stdin if args.input == "-" else Path(args.input).open(encoding="utf-8")
        try:
            payload = json.load(source)
        finally:
            if source is not sys.stdin:
                source.close()
        result = evaluate(
            payload,
            api_key=api_key_from_environment(args.env_file),
            timeout=args.timeout,
            retries=args.retries,
        )
    except (OSError, UnicodeError, json.JSONDecodeError):
        error = JevError("invalid_input", 2)
    except JevError as exc:
        error = exc
    else:
        json.dump(result, sys.stdout, ensure_ascii=False, separators=(",", ":"))
        sys.stdout.write("\n")
        return 0
    json.dump(error.as_json(), sys.stderr, separators=(",", ":"))
    sys.stderr.write("\n")
    return error.exit_code


if __name__ == "__main__":
    raise SystemExit(main())
